# Untangled Smart IT - Backend Environment Variables
# Copy to .env and fill real values. NEVER commit .env.

# Required in production
MONGODB_URI=
JWT_SECRET=

# Server
PORT=5001
DESKTOP_PORT=10000
NODE_ENV=development

# CORS – comma-separated exact origins (required in production)
# Dev default includes localhost:5173 and :5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

FRONTEND_URL=http://localhost:5173

# Rate limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
# RATE_LIMIT_AUTH_MAX=20

# MongoDB performance (optional)
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_IDLE_TIME_MS=30000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_SOCKET_TIMEOUT_MS=10000
# MONGODB_CONNECT_TIMEOUT_MS=5000

# Slow-request diagnostics (optional)
# SLOW_REQUEST_MS=500

# Set true only when your MongoDB deployment requires TLS (e.g. some hosted setups).
MONGODB_TLS=false
